<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Eliminar Registro</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #f3f4f6; padding: 40px; display: flex; justify-content: center; }
        .card { background: white; padding: 35px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); width: 100%; max-width: 450px; border: 1px solid #e5e7eb; }
        h2 { color: #dc2626; margin-top: 0; padding-bottom: 15px; border-bottom: 2px solid #f1f5f9; }
        .search-box { display: flex; gap: 10px; margin-bottom: 20px; }
        input { padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box; }
        .btn-dark { background: #1e293b; color: white; border: none; padding: 10px 15px; border-radius: 6px; cursor: pointer; font-weight: 600; }
        .danger-zone { background: #fef2f2; border: 1px solid #fee2e2; padding: 15px; border-radius: 8px; color: #991b1b; margin-bottom: 15px; font-size: 15px; }
        .btn-delete { width: 100%; background: #dc2626; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 15px; }
        .btn-back { display: block; text-align: center; margin-top: 15px; color: #6b7280; text-decoration: none; font-size: 14px; }
        .error { background: #fef2f2; color: #991b1b; padding: 10px; border-radius: 6px; border: 1px solid #fee2e2; font-size: 14px; }
    </style>
</head>
<body>
    <div class="card">
        <h2>🗑️ Eliminar Registro</h2>
        <form action="/eliminar" method="GET" class="search-box">
            <input 
                type="text" 
                name="cedula" 
                value="<%= cedulaBuscar || '' %>" 
                placeholder="Cédula a buscar..." 
                style="flex-grow: 1;" 
                required
                minlength="8"
                maxlength="8"
                pattern="\d{8}"
                title="Debes ingresar una cédula exacta de 8 dígitos numéricos"
            >
            <button type="submit" class="btn-dark">Buscar</button>
        </form>

        <% if (cedulaBuscar) { %>
            <% if (estudiante) { %>
                <div class="danger-zone">
                    <p style="margin-top:0;"><strong>¿Estás seguro de eliminar de forma permanente este registro?</strong></p>
                    <p style="margin-bottom:0;">👤 <strong>Nombre:</strong> <%= estudiante.nombre %><br>🪪 <strong>Cédula:</strong> <%= estudiante.cedula %></p>
                </div>
                <form action="/eliminar" method="POST">
                    <input type="hidden" name="cedula" value="<%= estudiante.cedula %>">
                    <button type="submit" class="btn-delete">⚠️ Confirmar Eliminación Irreversible</button>
                </form>
            <% } else { %>
                <p class="error">❌ Alumno no encontrado.</p>
            <% } %>
        <% } %>
        <a href="/" class="btn-back">↩ Cancelar</a>
    </div>
</body>
</html>